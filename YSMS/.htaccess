Options -Indexes

# PHP Errors దాచడానికి (లైవ్ లో యూజర్లకు ఎర్రర్స్ కనిపించకూడదు)
php_flag display_errors Off
# Errors are still LOGGED server-side (visible via Cloud Run logs) so problems
# can be diagnosed, but never shown to the visitor (log_errors On, display Off).
php_flag log_errors On
php_value error_reporting 32767